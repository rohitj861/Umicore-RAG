# Secrets / environment
.env
.env.*
!.env.example

# Streamlit secrets, if ever mirrored locally. The real values belong in the
# hosting provider's dashboard; only the template is tracked.
.streamlit/secrets.toml

# Python virtual environment
.venv/
venv/

# The generated vector store IS tracked, deliberately. A hosted deployment
# cannot run ingest.py - it has no PDF and no reason to spend the API credits
# on every cold start - so the store ships with the repo instead. Rebuilding it
# locally and committing the result replaces ~28 MB each time; if that history
# becomes a nuisance, move the store to a hosted vector DB and ignore it again.
# chroma_db/

# Source documents. The report is Umicore's to distribute, not ours, so it
# is kept out of the repo; drop your own copy in this folder to run ingest.
*.pdf

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
