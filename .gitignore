# Secrets / environment
.env
.env.*
!.env.example

# Streamlit secrets, if ever mirrored locally. The real values belong in the
# hosting provider's dashboard; only the template is tracked.
.streamlit/secrets.toml

# Python virtual environment
.venv/
venv/

# Generated vector store
chroma_db/

# Source documents. The report is Umicore's to distribute, not ours, so it
# is kept out of the repo; drop your own copy in this folder to run ingest.
*.pdf

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
