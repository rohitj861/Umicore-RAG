# Secrets for a hosted deployment.
#
# Do NOT copy this to secrets.toml locally - a local run reads .env instead.
# Paste the contents (without this comment block) into your hosting provider's
# secrets editor. On Streamlit Community Cloud that is:
#   your app -> Settings -> Secrets
#
# app.py's load_hosted_secrets() copies these into the environment, where
# ask.py's os.getenv lookups find them.

OPENAI_API_KEY = "sk-..."

# Optional. Set it and the app asks for this password before answering
# anything - worth having on a public URL, since every answer spends the key
# above. Leave it out and the app is open to anyone with the link.
APP_PASSWORD = "choose-something-long"

# Optional. Cohere Rerank for the "Semantic only" search mode. Leave it out and
# that mode runs as plain embedding search; hybrid search never uses it.
COHERE_API_KEY = "..."
# COHERE_RERANK_MODEL = "rerank-v4.0-pro"
