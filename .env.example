# Copy to .env and fill in your key. .env is gitignored; this template is not.
OPENAI_API_KEY=your-openai-api-key-here

# Optional password gate. There is nothing to obtain here - you invent this
# value, and the app asks visitors for it before it will answer anything.
# Worth setting on any URL other people can reach, because every answer spends
# the key above and there is no rate limiting.
#
# Uncomment and replace the value to switch the gate on. While the line stays
# commented the variable is unset, and the app is open - which is what you want
# for a local run.
# APP_PASSWORD=choose-a-long-phrase-you-will-remember

# Optional. Cohere Rerank for the "Semantic only" search mode - it reorders the
# embedding search's candidates. Without it that mode runs as plain embedding
# search, and hybrid search never uses it either way. Get a key from the Cohere
# dashboard; a trial key is rate limited.
# COHERE_API_KEY=your-cohere-api-key-here
# COHERE_RERANK_MODEL=rerank-v4.0-pro
# Spaces rerank calls to stay under a rate limit (a trial key allows 10 a
# minute). evaluate.py uses 10 when this is unset; the app does not pace.
# COHERE_CALLS_PER_MINUTE=10

# For a hosted deployment these go in the host's secrets editor instead -
# see .streamlit/secrets.toml.example. There is no .env in a deployment.
